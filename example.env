# Database (PostgreSQL)
POSTGRES_USER=webhook_user
POSTGRES_PASSWORD=webhook_password
POSTGRES_DB=webhook_db
POSTGRES_HOST=db

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Application Security
API_KEY=change-me-in-production
SECRET_KEY=change-me-in-production-secret
CORS_ORIGINS=["*"]

# Development Mode
DEVELOPMENT=true
USE_SQLITE=true
USE_MEMORY_BROKER=true
